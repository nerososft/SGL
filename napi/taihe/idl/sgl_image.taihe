enum SglBufferType: i32 {
  SGL_BUFFER_TYPE_UNIFORM = 0,
  SGL_BUFFER_TYPE_STORAGE_LOCAL,
  SGL_BUFFER_TYPE_STORAGE_SHARED,
  SGL_BUFFER_TYPE_VERTEX,
  SGL_BUFFER_TYPE_INDEX,
  SGL_BUFFER_TYPE_UNKNOWN,
}

struct SglBuffer {
  type: SglBufferType;
  bufHandle_ptr: u64;
  memHandle_ptr: u64;
  data_ptr: u64;
  bufferSize: u64;
}

struct SglImageGpuInfo {
  width: u32;
  height: u32;
  channels: u32;
  bytesPerLine: u32;
  gpuBuf: SglBuffer;
}

struct SglImageCpuInfo {
  width: u32;
  height: u32;
  channels: u32;
  bytesPerLine: u32;
  data_ptr: u64;
}

enum SglImageType: i32 {
  SGL_IMAGE_TYPE_CPU = 0,
  SGL_IMAGE_TYPE_GPU = 1,
  SGL_IMAGE_TYPE_UNKNOWN = 2
}

union Info {
    gpu: SglImageGpuInfo;
    cpu: SglImageCpuInfo;
}

struct SglImageInfo {
  type: SglImageType;
  info: Info;
}

function gray(in: const SglImageInfo, out: const SglImageInfo, r: float, g: float, b:float):sgl_error_t;
function threshold_split(in: const SglImageInfo, out: const SglImageInfo, bright: i32):sgl_error_t;
function gaussian_blur(in: const SglImageInfo, out: const SglImageInfo, r: i32):sgl_error_t;
function gaussian_blur_float(in: const SglImageInfo, out: const SglImageInfo, r: i32): sgl_error_t;
function surface_blur(in: const SglImageInfo, out: const SglImageInfo, r: i32, th: i32): sgl_error_t;
function distort_glass(in: const SglImageInfo, out: const SglImageInfo, scale: float, intensity: float, zoom: float): sgl_error_t;
function adjust_saturation(in: const SglImageInfo, out: const SglImageInfo, v: float, s: float): sgl_error_t;
function palette_knife(in: const SglImageInfo, out: const SglImageInfo, r: i32, s: i32): sgl_error_t;
function hue_equal(in: const SglImageInfo, out: const SglImageInfo): sgl_error_t;
function blur_edge(in: const SglImageInfo, out: const SglImageInfo, r: i32, s: i32, kernel_type: i32): sgl_error_t;
function custom_kernel(in: const SglImageInfo, out: const SglImageInfo, k_i32ptr: u64, radius: i32, offset: i32, scale: i32): sgl_error_t;
function color_balance(in: const SglImageInfo, out: const SglImageInfo, adjustP_fptr: u64, p_i32ptr: u64, l: i32): sgl_error_t;
function black_white(in: const SglImageInfo, out: const SglImageInfo, weight_fptr: u64, wSize: i32): sgl_error_t;
function scale(in: const SglImageInfo, out: const SglImageInfo, weight: i32, height: i32, type: i32): sgl_error_t;
function color_separation(in: const SglImageInfo, out: const SglImageInfo, roff: float, goff: float, boff: float): sgl_error_t;
function mid_value(in: const SglImageInfo, out: const SglImageInfo, radius: float, threshold: float): sgl_error_t;
function path_blur(in: const SglImageInfo, out: const SglImageInfo, vec_fptr: u64, amount: i32, width: i32, height: i32, startpos_fptr: u64, endpos_fptr: u64, startvec_fptr: u64, endvec_fptr: u64, num: i32): sgl_error_t;
function crystallize(in: const SglImageInfo, out: const SglImageInfo, posx_fptr: u64, posy_fptr: u64, n: i32): sgl_error_t;
function rotation_blur(in: const SglImageInfo, in2: const SglImageInfo, out: const SglImageInfo, x: float, y: float, a: float, b: float, ina: float, inb: float, strength: i32, angle: float ): sgl_error_t;
function facet(in: const SglImageInfo, out: const SglImageInfo, radius: i32, intensitylevel: i32): sgl_error_t;
