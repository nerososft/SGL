function tilt_shift_blur(in: const SglImageInfo, in2: const SglImageInfo, out: const SglImageInfo, A_fptr: u64, B_fptr: u64, C_fptr: u64, xoffset: float, yoffset: float, size: i32): sgl_error_t;
function radial_blur(in: const SglImageInfo, out: const SglImageInfo, sharpness: float, strength: i32, xCenter: float, yCenter: float): sgl_error_t;
