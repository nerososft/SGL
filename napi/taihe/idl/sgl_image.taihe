function color_halftone(in: const SglImageInfo, out: const SglImageInfo, cyanAngle: float, yellowAngle: float, magentaAngle: float, radius: float, lookup_fptr: u64): sgl_error_t;
function sharpen(in: const SglImageInfo, out: const SglImageInfo, kernel_i32ptr: u64, size: i32): sgl_error_t;
