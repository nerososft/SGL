enum SglBufferType {
  SGL_BUFFER_TYPE_UNIFORM = 0,
  SGL_BUFFER_TYPE_STORAGE_LOCAL,
  SGL_BUFFER_TYPE_STORAGE_SHARED,
  SGL_BUFFER_TYPE_VERTEX,
  SGL_BUFFER_TYPE_INDEX,
  SGL_BUFFER_TYPE_UNKNOWN,
};

struct SglBuffer {
  type: SglBufferType;
  bufHandle_ptr: u64;
  memHandle_ptr: u64;
  data_ptr: u64;
  bufferSize: u64;
};

struct SglImageGpuInfo {
  width: u32;
  height: u32;
  channels: u32;
  bytesPerLine: u32;
  gpuBuf: SglBuffer;
};

struct SglImageCpuInfo {
  width: u32;
  height: u32;
  channels: u32;
  bytesPerLine: u32;
  data_ptr: u64;
};

enum SglImageType {
  SGL_IMAGE_TYPE_CPU = 0,
  SGL_IMAGE_TYPE_GPU = 1,
  SGL_IMAGE_TYPE_UNKNOWN = 2
};

struct SglImageInfo {
  type: SglImageType;
  info: union {
    gpu: SglImageGpuInfo;
    cpu: SglImageCpuInfo;
  };
};

