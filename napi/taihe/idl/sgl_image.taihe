enum SglBufferType {
  SGL_BUFFER_TYPE_UNIFORM = 0,
  SGL_BUFFER_TYPE_STORAGE_LOCAL,
  SGL_BUFFER_TYPE_STORAGE_SHARED,
  SGL_BUFFER_TYPE_VERTEX,
  SGL_BUFFER_TYPE_INDEX,
  SGL_BUFFER_TYPE_UNKNOWN,
};

struct SglBuffer {
  SglBufferType type;
  void *bufHandle;
  void *memHandle;
  void *data;
  size_t bufferSize;
};

struct SglImageGpuInfo {
  uint32_t width;
  uint32_t height;
  uint32_t channels;
  uint32_t bytesPerLine;
  SglBuffer gpuBuf;
};

struct SglImageCpuInfo {
  uint32_t width;
  uint32_t height;
  uint32_t channels;
  uint32_t bytesPerLine;
  void *data;
};

enum SglImageType {
  SGL_IMAGE_TYPE_CPU = 0,
  SGL_IMAGE_TYPE_GPU = 1,
  SGL_IMAGE_TYPE_UNKNOWN = 2
};

struct SglImageInfo {
  SglImageType type;
  union {
    SglImageGpuInfo gpu;
    SglImageCpuInfo cpu;
  } info;
};

