enum SglError: i32 {
  SGL_SUCCESS = 0,
  SGL_FAILURE = 1,
  SGL_GPU_ERROR = 2,
  SGL_OUT_OF_MEMORY = 3,
  SGL_INVALID_ARGUMENT = 4,
}

enum SglBufferType: i32 {
  SGL_BUFFER_TYPE_UNIFORM = 0,
  SGL_BUFFER_TYPE_STORAGE_LOCAL,
  SGL_BUFFER_TYPE_STORAGE_SHARED,
  SGL_BUFFER_TYPE_VERTEX,
  SGL_BUFFER_TYPE_INDEX,
  SGL_BUFFER_TYPE_UNKNOWN,
}

struct SglBuffer {
  type: SglBufferType;
  bufHandle_ptr: u64;
  memHandle_ptr: u64;
  data_ptr: u64;
  bufferSize: u64;
}

struct SglImageGpuInfo {
  width: u32;
  height: u32;
  channels: u32;
  bytesPerLine: u32;
  gpuBuf: SglBuffer;
}

struct SglImageCpuInfo {
  width: u32;
  height: u32;
  channels: u32;
  bytesPerLine: u32;
  data_ptr: u64;
}

enum SglImageType: i32 {
  SGL_IMAGE_TYPE_CPU = 0,
  SGL_IMAGE_TYPE_GPU = 1,
  SGL_IMAGE_TYPE_UNKNOWN = 2
}

union Info {
    gpu: SglImageGpuInfo;
    cpu: SglImageCpuInfo;
}

struct SglImageInfo {
  type: SglImageType;
  info: Info;
}

function gray(in: SglImageInfo, out: SglImageInfo, r: f32, g: f32, b: f32): SglError;
function threshold_split(in: SglImageInfo, out: SglImageInfo, bright: i32): SglError;
function gaussian_blur(in: SglImageInfo, out: SglImageInfo, r: i32): SglError;
function gaussian_blur_float(in: SglImageInfo, out: SglImageInfo, r: i32): SglError;
function surface_blur(in: SglImageInfo, out: SglImageInfo, r: i32, th: i32): SglError;
function distort_glass(in: SglImageInfo, out: SglImageInfo, scale: f32, intensity: f32, zoom: f32): SglError;
function adjust_saturation(in: SglImageInfo, out: SglImageInfo, v: f32, s: f32): SglError;
function palette_knife(in: SglImageInfo, out: SglImageInfo, r: i32, s: i32): SglError;
function hue_equal(in: SglImageInfo, out: SglImageInfo): SglError;
function blur_edge(in: SglImageInfo, out: SglImageInfo, r: i32, s: i32, kernel_type: i32): SglError;
function custom_kernel(in: SglImageInfo, out: SglImageInfo, k_i32ptr: u64, radius: i32, offset: i32, scale: i32): SglError;
function color_balance(in: SglImageInfo, out: SglImageInfo, adjustP_fptr: u64, p_i32ptr: u64, l: i32): SglError;
function black_white(in: SglImageInfo, out: SglImageInfo, weight_fptr: u64, wSize: i32): SglError;
function scale(in: SglImageInfo, out: SglImageInfo, weight: i32, height: i32, type: i32): SglError;
function color_separation(in: SglImageInfo, out: SglImageInfo, roff: f32, goff: f32, boff: f32): SglError;
function mid_value(in: SglImageInfo, out: SglImageInfo, radius: f32, threshold: f32): SglError;
function path_blur(in: SglImageInfo, out: SglImageInfo, vec_fptr: u64, amount: i32, width: i32, height: i32, startpos_fptr: u64, endpos_fptr: u64, startvec_fptr: u64, endvec_fptr: u64, num: i32): SglError;
function crystallize(in: SglImageInfo, out: SglImageInfo, posx_fptr: u64, posy_fptr: u64, n: i32): SglError;
function rotation_blur(in: SglImageInfo, in2: SglImageInfo, out: SglImageInfo, x: f32, y: f32, a: f32, b: f32, ina: f32, inb: f32, strength: i32, angle: f32 ): SglError;
function facet(in: SglImageInfo, out: SglImageInfo, radius: i32, intensitylevel: i32): SglError;
function accented_edge(in: SglImageInfo, out: SglImageInfo, sobelx_i32ptr: u64, sobely_i32ptr: u64, size: i32, type: i32): SglError;
function iris_blur(in: SglImageInfo, in2: SglImageInfo, out: SglImageInfo, x: f32, y: f32, a: f32, b: f32, ina: f32, inb: f32, angle: f32): SglError;
function tilt_shift_blur(in: SglImageInfo, in2: SglImageInfo, out: SglImageInfo, A_fptr: u64, B_fptr: u64, C_fptr: u64, xoffset: f32, yoffset: f32, size: i32): SglError;
function radial_blur(in: SglImageInfo, out: SglImageInfo, sharpness: f32, strength: i32, xCenter: f32, yCenter: f32): SglError;
function rotational_blur(in: SglImageInfo, out: SglImageInfo, angle: f32, strength: i32, x: f32, y: f32): SglError;
function minmax(in: SglImageInfo, out: SglImageInfo, radius: i32, type: i32): SglError;
function color_halftone(in: SglImageInfo, out: SglImageInfo, cyanAngle: f32, yellowAngle: f32, magentaAngle: f32, radius: f32, lookup_fptr: u64): SglError;
function sharpen(in: SglImageInfo, out: SglImageInfo, kernel_i32ptr: u64, size: i32): SglError;
function polar_coordinates(in: SglImageInfo, out: SglImageInfo, type: i32): SglError;
function clouds(in: SglImageInfo, out: SglImageInfo, permuteLookup_i32ptr: u64, size: i32, type: i32): SglError;
function motion_blur(in: SglImageInfo, out: SglImageInfo, distance: i32, angle: i32, proportion: f32): SglError;
function twirl_warp(in: SglImageInfo, out: SglImageInfo, angle: i32): SglError;
function zigzag(in: SglImageInfo, out: SglImageInfo, wavelength: i32, amplitude: i32, type_wave: i32, proportion: f32): SglError;
function spherize(in: SglImageInfo, out: SglImageInfo, alpha: i32, type: i32): SglError;
function pinch(in: SglImageInfo, out: SglImageInfo, amount: i32): SglError;
function wave(in: SglImageInfo, out: SglImageInfo, wavelength: i32, amplitude: i32, x_pro: i32, y_pro: i32, type: i32, method: i32): SglError;